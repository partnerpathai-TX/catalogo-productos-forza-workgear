<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Copy Forza WorkGear</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>
:root{
  --bg:#F2EFEA; --sunk:#E7E2DA; --surface:#FFFFFF; --field:#FFFFFF;
  --ink:#191614; --ink-2:#4A433E; --muted:#7C736C;
  --line:#DBD4CA; --line-2:#C7BEB2;
  --accent:#D2500A; --accent-soft:#FBEADF; --on-accent:#FFFFFF;
  --flag-dup:#A8560B; --flag-dup-bg:#FBEEDC;
  --flag-check:#8C3125; --flag-check-bg:#FAE6E2;
  --grupo:#2F5F7A; --grupo-bg:#E3EDF3;
  --ok:#2F6B4F; --warn:#A8560B;
  --shadow:0 1px 2px rgba(25,22,20,.05), 0 8px 20px -14px rgba(25,22,20,.30);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#17150F; --sunk:#100F0B; --surface:#211E18; --field:#1A1813;
    --ink:#F2EEE6; --ink-2:#CFC7BB; --muted:#968D81;
    --line:#332F27; --line-2:#453F35;
    --accent:#FF7A34; --accent-soft:#33200F; --on-accent:#1B1409;
    --flag-dup:#E5A860; --flag-dup-bg:#332512;
    --flag-check:#E39184; --flag-check-bg:#301A16;
    --grupo:#8FBBD4; --grupo-bg:#152630;
    --ok:#7FC29B; --warn:#E5A860;
    --shadow:0 1px 2px rgba(0,0,0,.4), 0 10px 24px -16px rgba(0,0,0,.8);
  }
}
:root[data-theme="dark"]{
  --bg:#17150F; --sunk:#100F0B; --surface:#211E18; --field:#1A1813;
  --ink:#F2EEE6; --ink-2:#CFC7BB; --muted:#968D81;
  --line:#332F27; --line-2:#453F35;
  --accent:#FF7A34; --accent-soft:#33200F; --on-accent:#1B1409;
  --flag-dup:#E5A860; --flag-dup-bg:#332512;
  --flag-check:#E39184; --flag-check-bg:#301A16;
  --grupo:#8FBBD4; --grupo-bg:#152630;
  --ok:#7FC29B; --warn:#E5A860;
  --shadow:0 1px 2px rgba(0,0,0,.4), 0 10px 24px -16px rgba(0,0,0,.8);
}
html{color-scheme:light dark}
*{box-sizing:border-box}
img{max-width:100%}
body{margin:0; background:var(--bg); color:var(--ink);
  font-family:"IBM Plex Sans", system-ui, -apple-system, Segoe UI, sans-serif;
  font-size:15px; line-height:1.55; -webkit-font-smoothing:antialiased}
.wrap{max-width:1080px; margin:0 auto; padding:0 20px}

.top{border-bottom:1px solid var(--line); background:var(--surface)}
.top .wrap{padding:32px 20px 24px; display:flex; flex-direction:column; gap:13px}
.eyebrow{font-family:"IBM Plex Mono",monospace; font-size:11px; font-weight:500;
  letter-spacing:.16em; text-transform:uppercase; color:var(--accent); margin:0}
h1{font-family:"Barlow Condensed","Arial Narrow",sans-serif; font-weight:700;
  font-size:clamp(36px,6.2vw,54px); line-height:.98; margin:0; text-transform:uppercase; text-wrap:balance}
.lede{margin:0; max-width:62ch; color:var(--ink-2)}
.stats{display:flex; flex-wrap:wrap; gap:8px 22px; margin:2px 0 0; padding:0; list-style:none}
.stats li{display:flex; align-items:baseline; gap:7px; font-size:13px; color:var(--muted)}
.stats b{font-family:"Barlow Condensed",sans-serif; font-size:22px; font-weight:600;
  color:var(--ink); font-variant-numeric:tabular-nums}

.bar{position:sticky; top:0; z-index:30; background:var(--bg); border-bottom:1px solid var(--line)}
.bar .wrap{padding:11px 20px; display:flex; flex-wrap:wrap; gap:9px; align-items:center}
.search{position:relative; flex:1 1 220px; min-width:0}
.search svg{position:absolute; left:11px; top:50%; transform:translateY(-50%);
  width:15px; height:15px; color:var(--muted); pointer-events:none}
input,select,textarea{font:inherit; color:var(--ink); background:var(--field);
  border:1px solid var(--line-2); border-radius:3px; -webkit-appearance:none; appearance:none}
input[type="search"]{width:100%; font-size:14px; padding:9px 12px 9px 33px}
input::placeholder,textarea::placeholder{color:var(--muted)}
select{font-size:14px; padding:9px 28px 9px 11px;
  background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),linear-gradient(135deg,currentColor 50%,transparent 50%);
  background-position:calc(100% - 15px) 51%, calc(100% - 10px) 51%;
  background-size:5px 5px,5px 5px; background-repeat:no-repeat}
.count{font-family:"IBM Plex Mono",monospace; font-size:12px; color:var(--muted);
  font-variant-numeric:tabular-nums; margin-left:auto; white-space:nowrap;
  display:flex; gap:10px; align-items:center}
.saved{color:var(--ok); opacity:0; transition:opacity .2s}
.saved.on{opacity:1}

details.tools{border-bottom:1px solid var(--line); background:var(--sunk)}
details.tools > summary{cursor:pointer; list-style:none; padding:10px 20px; max-width:1080px;
  margin:0 auto; font-family:"IBM Plex Mono",monospace; font-size:11.5px; letter-spacing:.1em;
  text-transform:uppercase; color:var(--muted); display:flex; align-items:center; gap:8px}
details.tools > summary::-webkit-details-marker{display:none}
details.tools > summary::before{content:"+"; font-size:14px; line-height:1; color:var(--accent)}
details.tools[open] > summary::before{content:"−"}
.toolgrid{max-width:1080px; margin:0 auto; padding:2px 20px 18px;
  display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px}
.tool{background:var(--surface); border:1px solid var(--line); border-radius:4px;
  padding:13px 14px; display:flex; flex-direction:column; gap:8px}
.tool h4{margin:0; font-size:13px; font-weight:600}
.tool p{margin:0; font-size:12.5px; color:var(--muted); line-height:1.45}
.tool .row{display:flex; gap:7px}
.tool input{flex:1; min-width:0; font-size:13.5px; padding:7px 10px}

button{font:inherit; cursor:pointer; border-radius:3px;
  transition:background .13s, border-color .13s, color .13s}
.btn{display:inline-flex; align-items:center; gap:7px; font-size:13.5px; font-weight:500;
  padding:8px 13px; border:1px solid var(--line-2); background:var(--surface); color:var(--ink)}
.btn:hover{border-color:var(--ink-2)}
.btn-primary{background:var(--accent); border-color:var(--accent); color:var(--on-accent); font-weight:600}
.btn-primary:hover{border-color:var(--accent); filter:brightness(1.08)}
.btn-sm{font-size:12px; padding:5px 9px; gap:5px}
.btn.ok,.btn-primary.ok{background:var(--ok); border-color:var(--ok); color:#fff}
.btn.bad{border-color:var(--warn); color:var(--warn)}
.btn svg{width:14px; height:14px; flex:none}
.btn-sm svg{width:12px; height:12px}
:focus-visible{outline:2px solid var(--accent); outline-offset:2px}

main .wrap{padding:24px 20px 56px}
.list{display:flex; flex-direction:column; gap:16px}
.card{background:var(--surface); border:1px solid var(--line); border-radius:5px;
  box-shadow:var(--shadow); overflow:hidden; display:grid; grid-template-columns:196px 1fr}
.card.edited{border-color:var(--accent)}
.shot{border-right:1px solid var(--line); background:var(--sunk); padding:16px;
  display:flex; flex-direction:column; gap:10px}
.shot > img{width:100%; aspect-ratio:1; object-fit:cover; display:block;
  border:1px solid var(--line); border-radius:3px; background:#fff}
.tira{display:grid; grid-template-columns:repeat(4,1fr); gap:6px}
.tira button{padding:0; border:1px solid var(--line-2); border-radius:3px; background:none;
  line-height:0; overflow:hidden; position:relative}
.tira button img{width:100%; aspect-ratio:1; object-fit:cover; display:block; background:#fff}
.tira button[aria-pressed="true"]{border-color:var(--accent); box-shadow:0 0 0 2px var(--accent-soft)}
.tira button[aria-pressed="true"]::after{content:"★"; position:absolute; top:1px; right:3px;
  font-size:10px; color:var(--accent); text-shadow:0 0 3px rgba(0,0,0,.6)}
.tira button:hover{border-color:var(--ink-2)}
.ayudatira{font-size:11px; color:var(--muted); line-height:1.35}
.meta{display:flex; align-items:baseline; justify-content:space-between; gap:8px}
.sku{font-family:"IBM Plex Mono",monospace; font-size:12px; font-weight:500;
  color:var(--accent); letter-spacing:.04em}
.fotos{font-size:11.5px; color:var(--muted); font-variant-numeric:tabular-nums}
.editedtag{font-family:"IBM Plex Mono",monospace; font-size:10px; letter-spacing:.1em;
  text-transform:uppercase; color:var(--accent); display:none}
.card.edited .editedtag{display:block}
.body{padding:15px 18px 18px; display:flex; flex-direction:column; gap:12px; min-width:0}
.linea{display:flex; flex-wrap:wrap; gap:8px; align-items:center}
.cat{font-family:"IBM Plex Mono",monospace; font-size:10.5px; font-weight:500;
  letter-spacing:.13em; text-transform:uppercase; color:var(--muted)}
.chip{font-family:"IBM Plex Mono",monospace; font-size:10px; letter-spacing:.09em;
  text-transform:uppercase; padding:3px 7px; border-radius:2px;
  background:var(--grupo-bg); color:var(--grupo)}
.chip-t{background:var(--accent-soft); color:var(--accent)}
.f-tallas{grid-column:1 / -1}
.f-tallas em{font-style:normal; font-size:11px; color:var(--muted); line-height:1.35}

label.f{display:flex; flex-direction:column; gap:5px; min-width:0}
label.f > span{font-family:"IBM Plex Mono",monospace; font-size:10px; letter-spacing:.12em;
  text-transform:uppercase; color:var(--muted)}
.f-nombre input{font-family:"Barlow Condensed","Arial Narrow",sans-serif; font-weight:600;
  font-size:24px; line-height:1.15; padding:6px 10px}
textarea.copy{width:100%; min-height:120px; resize:vertical; padding:13px 15px; line-height:1.62;
  font-size:14px; color:var(--ink-2); background:var(--sunk);
  border-left:3px solid var(--accent); overflow:hidden}
.ficha{display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px}
.ficha input,.ficha select{font-size:13.5px; padding:7px 10px; width:100%}
.ficha .mono input{font-family:"IBM Plex Mono",monospace; font-size:12.5px}

.flag{display:flex; gap:8px; align-items:flex-start; font-size:12.5px; line-height:1.45;
  padding:8px 11px; border-radius:3px}
.flag b{font-weight:600; font-family:"IBM Plex Mono",monospace; font-size:10.5px;
  letter-spacing:.1em; text-transform:uppercase; white-space:nowrap; padding-top:1px}
.flag-dup{background:var(--flag-dup-bg); color:var(--flag-dup)}
.flag-check{background:var(--flag-check-bg); color:var(--flag-check)}

details.urls{border:1px solid var(--line); border-radius:3px; background:var(--sunk)}
details.urls > summary{cursor:pointer; list-style:none; padding:8px 12px;
  font-family:"IBM Plex Mono",monospace; font-size:11px; letter-spacing:.09em;
  text-transform:uppercase; color:var(--muted); display:flex; align-items:center; gap:7px}
details.urls > summary::-webkit-details-marker{display:none}
details.urls > summary::before{content:"+"; color:var(--accent); font-size:13px}
details.urls[open] > summary::before{content:"−"}
.urlbody{padding:0 12px 12px; display:flex; flex-direction:column; gap:7px}
.urlrow{display:flex; gap:8px; align-items:center}
.urlrow .tag{font-family:"IBM Plex Mono",monospace; font-size:10px; letter-spacing:.08em;
  text-transform:uppercase; color:var(--muted); width:70px; flex:none}
.urlrow .tag.p{color:var(--accent)}
.urlrow code{flex:1; min-width:0; font-family:"IBM Plex Mono",monospace; font-size:11.5px;
  color:var(--ink-2); background:var(--surface); border:1px solid var(--line);
  border-radius:3px; padding:5px 8px; overflow-x:auto; white-space:nowrap}
.actions{display:flex; flex-wrap:wrap; gap:8px; align-items:center}
.spacer{flex:1}

@media (max-width:700px){
  .card{grid-template-columns:1fr}
  .shot{border-right:0; border-bottom:1px solid var(--line)}
  .tira{grid-template-columns:repeat(6,1fr)}
  .count{margin-left:0; width:100%}
  .urlrow{flex-wrap:wrap}
  .urlrow code{width:100%; flex:1 0 100%; order:3}
}
.empty{text-align:center; padding:64px 20px; color:var(--muted);
  border:1px dashed var(--line-2); border-radius:5px}
.foot{border-top:1px solid var(--line); background:var(--surface)}
.foot .wrap{padding:26px 20px 40px; display:flex; flex-direction:column; gap:11px}
.foot h3{font-family:"Barlow Condensed",sans-serif; text-transform:uppercase;
  font-size:19px; font-weight:600; margin:0}
.foot ul{margin:0; padding-left:18px; color:var(--ink-2); font-size:14px;
  display:flex; flex-direction:column; gap:5px; max-width:76ch}
.foot code{font-family:"IBM Plex Mono",monospace; font-size:12.5px; background:var(--sunk);
  border:1px solid var(--line); border-radius:3px; padding:1px 5px}
@media (prefers-reduced-motion:reduce){*{transition:none !important}}
</style>
</head>
<body>

<header class="top">
  <div class="wrap">
    <p class="eyebrow">Forza WorkGear &middot; catálogo Zeluga</p>
    <h1>Copy listo para publicar</h1>
    <p class="lede">Hoja de trabajo del catálogo. Edita nombre, copy, precio y link, elige cuál foto va de principal y descarga el CSV actualizado cuando termines. Lo que escribas se guarda solo en este navegador.</p>
    <ul class="stats">
      <li><b>43</b> productos</li>
      <li><b id="filasCsv">0</b> filas en el CSV</li>
      <li><b>77</b> fotos</li>
      <li><b id="pendPrecio">0</b> sin precio</li>
      <li><b id="pendLink">0</b> sin link</li>
    </ul>
  </div>
</header>

<div class="bar">
  <div class="wrap">
    <div class="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path></svg>
      <input type="search" id="q" placeholder="Buscar producto, material o modelo…" aria-label="Buscar producto">
    </div>
    <select id="cat" aria-label="Filtrar por categoría">
      <option value="">Todas las categorías</option>
      <option value="Botas">Botas</option>
      <option value="Cinturones y fundas">Cinturones y fundas</option>
      <option value="Clavadoras">Clavadoras</option>
      <option value="Cuerdas">Cuerdas</option>
      <option value="Herramienta manual">Herramienta manual</option>
      <option value="Lonas y mallas">Lonas y mallas</option>
      <option value="Mangueras de aire">Mangueras de aire</option>
      <option value="Rodilleras">Rodilleras</option>
      <option value="Seguridad">Seguridad</option>
    </select>
    <select id="estado" aria-label="Filtrar por estado">
      <option value="">Todos los estados</option>
      <option value="sinprecio">Sin precio</option>
      <option value="sinlink">Sin link</option>
      <option value="revisar">Por revisar</option>
      <option value="variantes">Con variantes</option>
      <option value="editado">Editados</option>
    </select>
    <button class="btn btn-primary" id="descargar" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"></path><path d="m7 12 5 5 5-5"></path><path d="M4 21h16"></path></svg>
      <span>Descargar CSV</span>
    </button>
    <span class="count"><span class="saved" id="saved">Guardado</span><span id="count"></span></span>
  </div>
</div>

<details class="tools">
  <summary>Herramientas rápidas</summary>
  <div class="toolgrid">
    <div class="tool">
      <h4>Moneda del catálogo</h4>
      <p>Meta exige el precio con moneda. Se exporta como <em>19.99 USD</em>.</p>
      <div class="row"><select id="moneda"><option>USD</option><option>MXN</option></select></div>
    </div>
    <div class="tool">
      <h4>Generar links del producto</h4>
      <p>Escribe el dominio de tu tienda y llena los links vacíos, uno por fila.</p>
      <div class="row">
        <input type="text" id="dominio" placeholder="https://tutienda.com/producto/">
        <button class="btn btn-sm" id="genLinks" type="button">Llenar</button>
      </div>
    </div>
    <div class="tool">
      <h4>Precio para los vacíos</h4>
      <p>Pon el mismo precio en todas las filas que aún no tienen uno. Después ajusta las que cambien.</p>
      <div class="row">
        <input type="text" id="precioBulk" inputmode="decimal" placeholder="49.99">
        <button class="btn btn-sm" id="genPrecio" type="button">Aplicar</button>
      </div>
    </div>
    <div class="tool">
      <h4>Deshacer mis cambios</h4>
      <p>Devuelve nombre, copy y foto principal a su valor original y borra precios y links capturados aquí.</p>
      <div class="row"><button class="btn btn-sm" id="reset" type="button">Restablecer todo</button></div>
    </div>
  </div>
</details>

<main>
  <div class="wrap"><div class="list" id="list"></div></div>
</main>

<footer class="foot">
  <div class="wrap">
    <h3>Antes de subir el feed</h3>
    <ul>
      <li>Meta rechaza el catálogo mientras la columna <code>price</code> o <code>link</code> esté vacía. El contador de arriba dice cuántas filas faltan.</li>
      <li>Los productos con varios colores ya quedaron separados en una fila por color, con el mismo <code>item_group_id</code> y su columna <code>color</code>. Cada color necesita su propio precio y su propio link.</li>
      <li>Las botas se exportan con una fila por talla, todas con el mismo <code>item_group_id</code> y su columna <code>size</code>. Si dejas de manejar una talla, bórrala del campo Tallas disponibles y esa fila deja de generarse.</li>
      <li>Faltan por resolver los productos marcados como posible duplicado. Si son el mismo, borra una de las dos filas del CSV.</li>
      <li><code>availability</code> y <code>condition</code> se exportan en inglés porque así los pide Meta, aunque aquí los veas en español.</li>
      <li>Tus cambios viven en este navegador. Para conservarlos fuera de aquí, usa <strong>Descargar CSV</strong>.</li>
    </ul>
  </div>
</footer>

<script>
const DATA = {"header":["id","producto_base","foto_principal","fotos_adicionales","image_link","additional_image_link","title","description","price","link","brand","availability","condition","item_group_id","color","size"],"urlbase":"https://raw.githubusercontent.com/partnerpathai-TX/catalogo-productos-forza-workgear/main/productos/","items":[{"id":"001","grupo":"","color":"","tallas":"","base":"1","cat":"Cinturones y fundas","nota":null,"nombre":"Funda de cuero gamuza Zeluga de 10 bolsillos con porta-martillo","copy":"🧰 Funda de cuero gamuza Zeluga — todo tu herramental a la mano\n\nFabricada en cuero gamuza grueso color café, con 10 bolsillos de distintos tamaños para clavos, tornillos, cinta métrica y herramienta de mano. Incluye dos ganchos metálicos reforzados para colgar martillo o pinzas.\n\n✅ Cuero gamuza de uso rudo\n✅ 10 bolsillos organizadores\n✅ Doble porta-martillo metálico\n✅ Costuras y remaches reforzados\n✅ Ideal para carpinteros, albañiles y contratistas\n\nSe adapta a cualquier cinturón de trabajo estándar. 💪","fotos":["1.1","1.2","1.3"],"imgs":["","",""]},{"id":"002","grupo":"","color":"","tallas":"","base":"4","cat":"Lonas y mallas","nota":["dup","Se ve igual que el 005. Decide si es un solo producto."],"nombre":"Malla de seguridad naranja Zeluga de uso rudo 12 mil 220 GSM","copy":"🏗️ Malla de seguridad naranja Zeluga — protege tu obra y a tu gente\n\nTejido de uso rudo de 12 mil de grosor y 220 GSM que deja pasar el aire pero detiene el escombro. Tratada contra rayos UV para que no se cristalice al sol y con ojales de bronce anticorrosivo en todo el perímetro.\n\n✅ 12 mil de grosor y 220 GSM\n✅ Tratada contra rayos UV\n✅ Resistente al agua\n✅ Ojales de bronce anticorrosivo\n✅ Costura perimetral reforzada\n\nPerfecta para cubrir andamio, contener escombro y dar sombra en obra. 💪","fotos":["4","4.1"],"imgs":["",""]},{"id":"003","grupo":"","color":"","tallas":"","base":"5","cat":"Lonas y mallas","nota":null,"nombre":"Lona de polietileno naranja Zeluga 20 x 30 pies 12 mil 220 GSM","copy":"🏗️ Lona de polietileno naranja Zeluga 20 x 30 pies — cubre y protege sin pretextos\n\nPolietileno de 12 mil de grosor y 220 GSM, 100% impermeable y tratado contra rayos UV. Dobladillo reforzado y ojales de bronce anticorrosivo cada pocos pies para amarrar sin que se rasgue.\n\n✅ Medida 20 x 30 pies\n✅ 12 mil de grosor y 220 GSM\n✅ 100% impermeable\n✅ Tratada contra rayos UV\n✅ Ojales de bronce anticorrosivo\n\nIdeal para proteger material, equipo, techos y remolques. 💪","fotos":["5"],"imgs":[""]},{"id":"004","grupo":"","color":"","tallas":"","base":"6","cat":"Lonas y mallas","nota":null,"nombre":"Lona de polietileno naranja Zeluga 20 x 20 pies 12 mil 220 GSM","copy":"🏗️ Lona de polietileno naranja Zeluga 20 x 20 pies — la medida más práctica\n\nPolietileno de 12 mil de grosor y 220 GSM, impermeable y tratado contra rayos UV. Dobladillo reforzado y ojales de bronce anticorrosivo para amarrar firme y aguantar viento.\n\n✅ Medida 20 x 20 pies\n✅ 12 mil de grosor y 220 GSM\n✅ 100% impermeable\n✅ Tratada contra rayos UV\n✅ Ojales de bronce anticorrosivo\n\nPerfecta para cubrir carga, material de obra y equipo. 💪","fotos":["6"],"imgs":[""]},{"id":"005","grupo":"","color":"","tallas":"","base":"9","cat":"Lonas y mallas","nota":["dup","Se ve igual que el 002. Decide si es un solo producto."],"nombre":"Lona de malla naranja Zeluga 20 x 30 pies 12 mil 220 GSM","copy":"🏗️ Lona de malla naranja Zeluga 20 x 30 pies — sombra y seguridad en una sola pieza\n\nModelo 24-551-2030 en tejido de 12 mil y 220 GSM. La malla deja pasar el aire, así que no hace vela con el viento como una lona sólida, y aguanta sol y lluvia sin cristalizarse.\n\n✅ Medida 20 x 30 pies\n✅ 12 mil de grosor y 220 GSM\n✅ Tratada contra rayos UV\n✅ Resistente al agua\n✅ Ojales de bronce anticorrosivo\n\nSirve como cubierta de obra, sombra de campamento y malla contra escombro. 💪","fotos":["9","9.1"],"imgs":["",""]},{"id":"006","grupo":"","color":"","tallas":"","base":"12","cat":"Cinturones y fundas","nota":null,"nombre":"Funda de cuero café Zeluga con porta cinta métrica","copy":"🧰 Funda de cuero café Zeluga — la herramienta que usas siempre, siempre a la mano\n\nCuero genuino color café oscuro con tapa protectora, varios bolsillos y divisiones para desarmadores, pinzas y navaja. Trae porta cinta métrica de acero y gancho giratorio para colgar herramienta pesada.\n\n✅ Cuero genuino de uso rudo\n✅ Tapa protectora\n✅ Porta cinta métrica de acero\n✅ Gancho giratorio reforzado\n✅ Presilla para cualquier cinturón\n\nIdeal para electricistas y técnicos de mantenimiento. 💪","fotos":["12","12.1"],"imgs":["",""]},{"id":"007-vino","grupo":"007","color":"Vino","tallas":"","base":"13","cat":"Rodilleras","nota":null,"nombre":"Rodilleras de cuero Zeluga forradas en borrega, color vino","copy":"🦵 Rodilleras de cuero Zeluga en vino — trabaja hincado todo el día sin sufrir\n\nCuero genuino color vino por fuera y forro de borrega por dentro, con dos correas de cuero y hebilla de metal que se ajustan a tu pierna y no se aflojan al moverte. Copete de cuero reforzado con remaches para aguantar concreto, madera y teja.\n\n✅ Cuero genuino de uso rudo\n✅ Forro interior de borrega\n✅ Dos correas ajustables con hebilla\n✅ Copete reforzado con remaches\n✅ No se resbalan al caminar hincado\n\nPresentación en cuero vino. Para instaladores de piso, plomeros y techadores. 💪","fotos":["13","13.2"],"imgs":["",""]},{"id":"007-negro","grupo":"007","color":"Negro","tallas":"","base":"13","cat":"Rodilleras","nota":null,"nombre":"Rodilleras de cuero Zeluga forradas en borrega, color negro","copy":"🦵 Rodilleras de cuero Zeluga en negro — trabaja hincado todo el día sin sufrir\n\nCuero genuino negro por fuera y forro de borrega por dentro, con dos correas de cuero y hebilla de metal que se ajustan a tu pierna y no se aflojan al moverte. Copete de cuero reforzado con remaches para aguantar concreto, madera y teja.\n\n✅ Cuero genuino de uso rudo\n✅ Forro interior de borrega\n✅ Dos correas ajustables con hebilla\n✅ Copete reforzado con remaches\n✅ No se resbalan al caminar hincado\n\nPresentación en cuero negro. Para instaladores de piso, plomeros y techadores. 💪","fotos":["13.3","13.1"],"imgs":["",""]},{"id":"007-natural","grupo":"007","color":"Natural","tallas":"","base":"13","cat":"Rodilleras","nota":null,"nombre":"Rodilleras de cuero Zeluga forradas en borrega, color natural","copy":"🦵 Rodilleras de cuero Zeluga en natural — trabaja hincado todo el día sin sufrir\n\nCuero natural sin teñir por fuera y forro de borrega por dentro, con correas de cuero y hebilla de metal que se ajustan a tu pierna. Copete de cuero reforzado con remaches para aguantar concreto, madera y teja.\n\n✅ Cuero natural de uso rudo\n✅ Forro interior de borrega\n✅ Correas ajustables con hebilla\n✅ Copete reforzado con remaches\n✅ No se resbalan al caminar hincado\n\nPresentación en cuero natural, que se oscurece bonito con el uso. 💪","fotos":["13.4"],"imgs":[""]},{"id":"008","grupo":"","color":"Café","tallas":"5, 5.5, 6, 6.5, 7, 7.5, 8, 8.5, 9, 9.5, 10, 10.5, 11","base":"14","cat":"Botas","nota":null,"nombre":"Bota de trabajo Rhino 90M07 de cuero curtido al aceite, café","copy":"🥾 Bota de trabajo Rhino 90M07 — te la pones y a trabajar\n\nBota sin agujetas de corte alto en cuero curtido al aceite, con suela cosida tipo Goodyear, la que permite resolear la bota en vez de tirarla. Plantilla acolchada y suela resistente al aceite.\n\n✅ Cuero curtido al aceite\n✅ Suela cosida tipo Goodyear\n✅ Suela resistente al aceite\n✅ Plantilla acolchada\n✅ Se calza y se quita en segundos\n\nColor café. Tallas de la 5 a la 11, incluyendo medias tallas. Para obra, rancho y trabajo pesado diario. 💪","fotos":["14","14.1","14.2","14.3"],"imgs":["","","",""]},{"id":"009","grupo":"","color":"","tallas":"","base":"15","cat":"Herramienta manual","nota":["check","Sin etiqueta en las fotos. Confirma que sí es barredor magnético."],"nombre":"Barredor magnético de mano Zeluga recoge clavos","copy":"🧲 Barredor magnético de mano — levanta el clavo antes de que levante tu llanta\n\nBarra magnética con mango largo y empuñadura cómoda que jala clavos, tornillos, grapas y rebaba metálica del piso sin que tengas que agacharte. Estructura de acero pintada en naranja de alta visibilidad.\n\n✅ Imán de alta potencia\n✅ Mango largo, cero agacharse\n✅ Estructura de acero\n✅ Acabado naranja de alta visibilidad\n✅ Libera el metal con solo levantarlo\n\nLimpia obras, talleres y estacionamientos en minutos. 💪","fotos":["15","15.1"],"imgs":["",""]},{"id":"010","grupo":"","color":"","tallas":"","base":"19","cat":"Cinturones y fundas","nota":null,"nombre":"Cinturón portaherramientas camuflaje Zeluga con tirantes","copy":"🧰 Cinturón portaherramientas camuflaje Zeluga — el set completo, listo para la obra\n\nCinturón acolchado con ojales metálicos, dos bolsas multibolsillo, porta celular y porta martillo, más tirantes acolchados desmontables con clips metálicos que pasan el peso de la cintura a los hombros.\n\n✅ Tela camuflaje resistente\n✅ Tirantes acolchados desmontables\n✅ Dos bolsas multibolsillo\n✅ Porta celular y porta martillo\n✅ Cinturón acolchado ajustable\n\nMenos dolor de espalda al final del día. 💪","fotos":["19.1","19.2","19.3","19.4"],"imgs":["","","",""]},{"id":"011","grupo":"","color":"","tallas":"","base":"21","cat":"Herramienta manual","nota":null,"nombre":"Marro Zeluga de 16 libras con mango de madera de 36 pulgadas","copy":"🔨 Marro Zeluga de 16 libras — para lo que no cede con nada más\n\nCabeza forjada de 16 libras montada en mango de madera de 36 pulgadas con cuña de sujeción reforzada, para que la cabeza no se afloje golpe tras golpe. Cara tratada para resistir el impacto sin astillarse.\n\n✅ Cabeza forjada de 16 libras\n✅ Mango de madera de 36 pulgadas\n✅ Cuña de sujeción reforzada\n✅ Cara tratada contra astillado\n✅ Balance para golpe largo\n\nPara demolición, estacas, concreto y trabajo pesado. 💪","fotos":["21","21.1"],"imgs":["",""]},{"id":"012","grupo":"","color":"","tallas":"","base":"25","cat":"Rodilleras","nota":null,"nombre":"Rodilleras de trabajo Zeluga de concha dura, naranja","copy":"🦵 Rodilleras de concha dura Zeluga — protección real, no un cojín\n\nConcha exterior rígida y antiderrapante que reparte el peso y no se entierra en el piso, con acolchado interior de alta densidad y correas elásticas ajustables con broche rápido.\n\n✅ Concha exterior rígida\n✅ Superficie antiderrapante\n✅ Acolchado de alta densidad\n✅ Correas elásticas con broche rápido\n✅ Se ponen y quitan en segundos\n\nPara instalar piso, teja, plomería o tablaroca. 💪","fotos":["25","25.1"],"imgs":["",""]},{"id":"013-azul","grupo":"013","color":"Azul","tallas":"","base":"28","cat":"Cinturones y fundas","nota":null,"nombre":"Tirantes acolchados Zeluga para cinturón de herramientas, azul","copy":"💪 Tirantes acolchados Zeluga en azul — quítale el peso a tu cintura\n\nHombreras anchas acolchadas con malla transpirable y correas totalmente ajustables. Los ganchos metálicos se conectan a prácticamente cualquier cinturón portaherramientas que ya tengas.\n\n✅ Hombreras acolchadas y transpirables\n✅ Correas ajustables a tu medida\n✅ Ganchos metálicos reforzados\n✅ Compatibles con cinturones estándar\n✅ Se ajustan a cualquier estatura\n\nColor azul. Si cargas herramienta todo el día, esto es lo primero que deberías comprar. 💪","fotos":["28"],"imgs":[""]},{"id":"013-rojo","grupo":"013","color":"Rojo","tallas":"","base":"28","cat":"Cinturones y fundas","nota":null,"nombre":"Tirantes acolchados Zeluga para cinturón de herramientas, rojo","copy":"💪 Tirantes acolchados Zeluga en rojo — quítale el peso a tu cintura\n\nHombreras anchas acolchadas con malla transpirable y correas totalmente ajustables. Los ganchos metálicos se conectan a prácticamente cualquier cinturón portaherramientas que ya tengas.\n\n✅ Hombreras acolchadas y transpirables\n✅ Correas ajustables a tu medida\n✅ Ganchos metálicos reforzados\n✅ Compatibles con cinturones estándar\n✅ Se ajustan a cualquier estatura\n\nColor rojo. Si cargas herramienta todo el día, esto es lo primero que deberías comprar. 💪","fotos":["28.1"],"imgs":[""]},{"id":"013-naranja","grupo":"013","color":"Naranja","tallas":"","base":"28","cat":"Cinturones y fundas","nota":null,"nombre":"Tirantes acolchados Zeluga para cinturón de herramientas, naranja","copy":"💪 Tirantes acolchados Zeluga en naranja — quítale el peso a tu cintura\n\nHombreras anchas acolchadas con malla transpirable y correas totalmente ajustables. Los ganchos metálicos se conectan a prácticamente cualquier cinturón portaherramientas que ya tengas.\n\n✅ Hombreras acolchadas y transpirables\n✅ Correas ajustables a tu medida\n✅ Ganchos metálicos reforzados\n✅ Compatibles con cinturones estándar\n✅ Naranja de alta visibilidad\n\nColor naranja. Si cargas herramienta todo el día, esto es lo primero que deberías comprar. 💪","fotos":["28.2"],"imgs":[""]},{"id":"013-negro","grupo":"013","color":"Negro","tallas":"","base":"28","cat":"Cinturones y fundas","nota":null,"nombre":"Tirantes acolchados Zeluga para cinturón de herramientas, negro","copy":"💪 Tirantes acolchados Zeluga en negro — quítale el peso a tu cintura\n\nHombreras anchas acolchadas con malla transpirable y correas totalmente ajustables. Los ganchos metálicos se conectan a prácticamente cualquier cinturón portaherramientas que ya tengas.\n\n✅ Hombreras acolchadas y transpirables\n✅ Correas ajustables a tu medida\n✅ Hebillas metálicas de ajuste rápido\n✅ Compatibles con cinturones estándar\n✅ Se ajustan a cualquier estatura\n\nColor negro. Si cargas herramienta todo el día, esto es lo primero que deberías comprar. 💪","fotos":["28.3"],"imgs":[""]},{"id":"014","grupo":"","color":"","tallas":"","base":"30","cat":"Cinturones y fundas","nota":null,"nombre":"Set de cinturón portaherramientas de cuero coñac Zeluga","copy":"🧰 Set de cinturón portaherramientas de cuero coñac Zeluga — se ve bien y aguanta mejor\n\nDos bolsas de cuero con tapa protectora, porta martillo, porta cinta métrica de acero y cinturón de cuero ajustable con hebilla reforzada. Interior en gamuza y remaches en cada esquina de tensión.\n\n✅ Cuero genuino color coñac\n✅ Dos bolsas con tapa protectora\n✅ Porta martillo y porta cinta\n✅ Cinturón ajustable con hebilla de acero\n✅ Remaches en puntos de tensión\n\nPara carpinteros, albañiles e instaladores. 💪","fotos":["30","30.1","30.2","30.3"],"imgs":["","","",""]},{"id":"015","grupo":"","color":"","tallas":"","base":"32","cat":"Mangueras de aire","nota":["dup","Mismo modelo 21-342 que el 025."],"nombre":"Manguera de aire Zeluga Z-Lite 1/4 x 100 pies, naranja","copy":"💨 Manguera de aire Z-Lite 1/4 x 100 pies — la mitad del peso, el doble de comodidad\n\nPoliuretano modelo 21-342 con trenzado interno reforzado y chaqueta exterior. Pesa muchísimo menos que una manguera de hule, así que la arrastras por toda la obra sin cansarte. Conexiones incluidas.\n\n✅ 1/4 de pulgada por 100 pies\n✅ Poliuretano ultraligero\n✅ Trenzado interno reforzado\n✅ Conexiones reusables y reparables en obra\n✅ Estabilizada contra rayos UV\n\nColor naranja de alta visibilidad, para que nadie se tropiece. 💪","fotos":["32"],"imgs":[""]},{"id":"016","grupo":"","color":"","tallas":"","base":"35","cat":"Mangueras de aire","nota":["dup","Mismo modelo 21-314 que el 026."],"nombre":"Manguera de aire Zeluga Z-Lite 1/4 x 100 pies, azul","copy":"💨 Manguera de aire Z-Lite 1/4 x 100 pies — ligera, flexible y lista para trabajar\n\nPoliuretano modelo 21-314 (PU14100B) con chaqueta exterior resistente. Se enrolla fácil, no se acordona con el frío y sus conexiones se pueden reusar para reparar la manguera en plena obra.\n\n✅ 1/4 de pulgada por 100 pies\n✅ Poliuretano ultraligero\n✅ Conexiones reusables\n✅ Reparable en obra\n✅ Estabilizada contra rayos UV\n\nColor azul. Para clavadoras, pistolas de aire y compresores. 💪","fotos":["35"],"imgs":[""]},{"id":"017","grupo":"","color":"","tallas":"","base":"36","cat":"Cinturones y fundas","nota":null,"nombre":"Set de cinturón portaherramientas Zeluga en lona verde y cuero","copy":"🧰 Set de cinturón portaherramientas Zeluga 89-222 — lona resistente con refuerzo de cuero\n\nDos bolsas en lona de alta resistencia color verde, ribeteadas y reforzadas con cuero en las esquinas y la boca, más porta martillo, porta cinta métrica y cinturón de cuero 100% genuino con doble hebilla.\n\n✅ Lona de alta resistencia\n✅ Refuerzos y ribete de cuero\n✅ Cinturón de cuero 100% genuino\n✅ Doble hebilla ajustable\n✅ Costura doble en puntos de tensión\n\nLigero como lona, duradero como cuero. 💪","fotos":["36","36.1","36.2","36.3"],"imgs":["","","",""]},{"id":"018","grupo":"","color":"Café","tallas":"5, 5.5, 6, 6.5, 7, 7.5, 8, 8.5, 9, 9.5, 10, 10.5, 11","base":"37","cat":"Botas","nota":null,"nombre":"Bota de trabajo Rhino de agujetas con punta de mocasín, café","copy":"🥾 Bota de trabajo Rhino punta de mocasín — clásica, cómoda y para toda la temporada\n\nCorte alto con agujetas y ojales de latón, cuero curtido al aceite y suela cosida tipo Goodyear. Suela de cuña resistente al aceite que no marca el piso y amortigua al caminar sobre concreto.\n\n✅ Cuero curtido al aceite\n✅ Punta de mocasín reforzada\n✅ Suela cosida tipo Goodyear\n✅ Suela de cuña resistente al aceite\n✅ Ojales de latón\n\nColor café. Tallas de la 5 a la 11, incluyendo medias tallas. Para carpintería, techos y obra en general. 💪","fotos":["37","37.1","37.2"],"imgs":["","",""]},{"id":"019-rojo","grupo":"019","color":"Rojo translúcido","tallas":"","base":"38","cat":"Mangueras de aire","nota":null,"nombre":"Manguera de aire Zeluga Z-Flex reforzada 1/4 x 100 pies 300 PSI, roja","copy":"💨 Manguera de aire Z-Flex 300 PSI en rojo — para el trabajo que exige presión\n\nPoliuretano reforzado modelo 21-306 con conector de bola giratorio de seis balines y tapón de seguridad de aire, que libera la presión de forma controlada al desconectar. Trabaja hasta 300 PSI.\n\n✅ 1/4 de pulgada por 100 pies\n✅ Presión de trabajo de 300 PSI\n✅ Conector de bola giratorio\n✅ Tapón de seguridad de aire\n✅ Rango de -40 a 165 grados F\n\nColor rojo translúcido, para ver por dónde va la manguera. Flexible incluso en frío. 💪","fotos":["38.1"],"imgs":[""]},{"id":"019-verde","grupo":"019","color":"Verde translúcido","tallas":"","base":"38","cat":"Mangueras de aire","nota":null,"nombre":"Manguera de aire Zeluga Z-Flex reforzada 1/4 x 100 pies 300 PSI, verde","copy":"💨 Manguera de aire Z-Flex 300 PSI en verde — para el trabajo que exige presión\n\nPoliuretano reforzado modelo 21-306 con conector de bola giratorio de seis balines y tapón de seguridad de aire, que libera la presión de forma controlada al desconectar. Trabaja hasta 300 PSI.\n\n✅ 1/4 de pulgada por 100 pies\n✅ Presión de trabajo de 300 PSI\n✅ Conector de bola giratorio\n✅ Tapón de seguridad de aire\n✅ Rango de -40 a 165 grados F\n\nColor verde translúcido, para ver por dónde va la manguera. Flexible incluso en frío. 💪","fotos":["38.2"],"imgs":[""]},{"id":"020","grupo":"","color":"","tallas":"","base":"42","cat":"Clavadoras","nota":null,"nombre":"Clavadora neumática de rollo para techo Zeluga 15 grados 28-145","copy":"🔩 Clavadora de rollo para techo Zeluga 28-145 — ponle ritmo al retecho\n\nClavadora neumática de rollo a 15 grados para clavo de 3/4 a 1-3/4 de pulgada, con capacidad de 120 clavos por carga. Cuerpo de aluminio tratado térmicamente: fuerte, pero de solo 2.75 kilos para que no te canse el brazo.\n\n✅ Clavo de 3/4 a 1-3/4 de pulgada\n✅ Capacidad de 120 clavos\n✅ Aluminio tratado térmicamente\n✅ Peso ligero de 2.75 kilos\n✅ Presión de operación de 70 a 110 PSI\n\nPara teja, cubiertas de madera, aislante, recubrimiento de vinil y fibrocemento. 💪","fotos":["42","42.1"],"imgs":["",""]},{"id":"021","grupo":"","color":"","tallas":"","base":"43","cat":"Clavadoras","nota":null,"nombre":"Clavadora neumática estructural Zeluga 28-512","copy":"🔩 Clavadora neumática estructural Zeluga 28-512 — para armar estructura rápido y parejo\n\nCargador angulado de alu