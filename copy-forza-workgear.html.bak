:"🧰 Set portaherramientas Zeluga de poliéster — ligero, lavable y de alta visibilidad\n\nCinturón acolchado con ojales metálicos, dos bolsas con bolsillos ribeteados en naranja de alta visibilidad, porta martillo y tirantes acolchados desmontables. Encuentras la herramienta de un vistazo.\n\n✅ Poliéster resistente y lavable\n✅ Interiores naranja de alta visibilidad\n✅ Tirantes acolchados desmontables\n✅ Cinturón acolchado con ojales metálicos\n✅ Porta martillo y bolsillos organizadores\n\nMucho más ligero que un set de cuero. 💪","fotos":["68","68.1","68.2","68.3"],"imgs":["","","",""]},{"id":"029","grupo":"","color":"","tallas":"","base":"79","cat":"Seguridad","nota":null,"nombre":"Arnés de cuerpo completo Zeluga para trabajo en altura","copy":"🦺 Arnés de cuerpo completo Zeluga — porque de altura no se regresa dos veces\n\nArgolla dorsal en D, argollas laterales y frontal para posicionamiento, hombreras y cinturón acolchados que reparten la carga, y hebillas ajustables en piernas y pecho para que quede a tu medida.\n\n✅ Argolla dorsal en D de acero\n✅ Argollas laterales y frontal\n✅ Hombreras y cinturón acolchados\n✅ Ajuste en piernas y pecho\n✅ Cintas de alta resistencia\n\nPara trabajo en altura, andamio, torre y rescate. 💪","fotos":["79","79.1"],"imgs":["",""]},{"id":"030-natural","grupo":"030","color":"Natural","tallas":"","base":"81","cat":"Cinturones y fundas","nota":null,"nombre":"Funda de cuero para electricista Zeluga 20-169, color natural","copy":"🧰 Funda de cuero para electricista Zeluga 20-169 — cuero natural que se cura con el uso\n\nCuero natural sin teñir con tapa protectora, múltiples bolsillos y divisiones para desarmadores y pinzas, porta cinta métrica de acero, gancho giratorio y presilla ancha para cinturón.\n\n✅ Cuero natural de uso rudo\n✅ Tapa protectora\n✅ Múltiples compartimentos\n✅ Porta cinta métrica de acero\n✅ Gancho giratorio reforzado\n\nColor natural, que se oscurece parejo conforme lo usas. 💪","fotos":["81"],"imgs":[""]},{"id":"030-cafe","grupo":"030","color":"Café","tallas":"","base":"81","cat":"Cinturones y fundas","nota":["check","La foto 81.1 se ve más oscura que la 81.2. Confirma si son dos tonos distintos o el mismo."],"nombre":"Funda de cuero para electricista Zeluga 20-169, color café","copy":"🧰 Funda de cuero para electricista Zeluga 20-169 — cuero café, listo para usarse\n\nCuero teñido color café con tapa protectora, múltiples bolsillos y divisiones para desarmadores y pinzas, porta cinta métrica de acero, gancho giratorio y presilla ancha para cinturón.\n\n✅ Cuero genuino de uso rudo\n✅ Tapa protectora\n✅ Múltiples compartimentos\n✅ Porta cinta métrica de acero\n✅ Gancho giratorio reforzado\n\nColor café, que no se marca tanto con el uso diario. 💪","fotos":["81.2","81.1"],"imgs":["",""]},{"id":"031","grupo":"","color":"","tallas":"","base":"87","cat":"Rodilleras","nota":null,"nombre":"Rodilleras de trabajo Zeluga de concha dura, gris","copy":"🦵 Rodilleras de concha dura Zeluga — el día largo se siente corto\n\nConcha exterior rígida con superficie antiderrapante y acolchado interno de alta densidad que no se aplasta con el uso. Correas ajustables con broche rápido que no aprietan la corva.\n\n✅ Concha exterior rígida\n✅ Acolchado de alta densidad\n✅ Superficie antiderrapante\n✅ Correas con broche rápido\n✅ No se resbalan al caminar hincado\n\nPara piso, teja, plomería y tablaroca. 💪","fotos":["87"],"imgs":[""]},{"id":"032","grupo":"","color":"","tallas":"","base":"90","cat":"Herramienta manual","nota":null,"nombre":"Barredor magnético rodante Zeluga recoge clavos","copy":"🧲 Barredor magnético rodante — un clavo menos es una llanta menos ponchada\n\nBarra magnética montada sobre ruedas con mango largo: solo caminas y el imán levanta clavos, tornillos, grapas y rebaba metálica del piso. Estructura de acero naranja de alta visibilidad.\n\n✅ Imán de alta potencia\n✅ Ruedas para recorrer áreas grandes\n✅ Mango largo, cero agacharse\n✅ Estructura de acero\n✅ Acabado naranja de alta visibilidad\n\nIndispensable al terminar un retecho o una demolición. 💪","fotos":["90"],"imgs":[""]},{"id":"033","grupo":"","color":"","tallas":"","base":"91","cat":"Cinturones y fundas","nota":null,"nombre":"Set de cinturón portaherramientas de cuero café Zeluga","copy":"🧰 Set de cinturón portaherramientas de cuero café Zeluga — el equipo completo\n\nDos bolsas de cuero gamuza con tapa de cuero liso, porta martillo metálico, porta cinta métrica y cinturón ajustable. Múltiples bolsillos de distintos tamaños y remaches en cada punto de tensión.\n\n✅ Cuero gamuza de uso rudo\n✅ Tapas de cuero liso protectoras\n✅ Porta martillo metálico\n✅ Múltiples compartimentos\n✅ Cinturón ajustable\n\nPara carpintería, construcción y remodelación. 💪","fotos":["91"],"imgs":[""]},{"id":"034","grupo":"","color":"","tallas":"","base":"92","cat":"Herramienta manual","nota":null,"nombre":"Pala quita tejas dentada con mango tipo D","copy":"🏠 Pala quita tejas dentada — levanta teja y clavo de un solo tirón\n\nCabeza de acero con dientes que atrapan la cabeza del clavo y punto de apoyo reforzado que hace palanca por ti. Mango con agarradera tipo D para jalar con las dos manos sin que se te resbale.\n\n✅ Cabeza de acero dentada\n✅ Punto de apoyo reforzado\n✅ Agarradera tipo D\n✅ Saca teja y clavos juntos\n✅ Acabado naranja de alta visibilidad\n\nLa herramienta que hace rápido un retecho. 💪","fotos":["92","92.1","92.2"],"imgs":["","",""]}]};
const KEY = 'forza-workgear-catalogo-v2';

const DISPONIBILIDAD = [
  ['in stock', 'En existencia'],
  ['out of stock', 'Agotado'],
  ['preorder', 'Preventa'],
  ['available for order', 'Sobre pedido'],
  ['discontinued', 'Descontinuado'],
];

const ORIG = {};
DATA.items.forEach((it) => {
  ORIG[it.id] = { nombre: it.nombre, copy: it.copy, price: '', link: '',
    availability: 'in stock', main: 0, tallas: it.tallas };
});

// Un producto con tallas se expande a varias filas del feed, una por talla.
function listaTallas(t){
  return String(t || '').split(',').map((s) => s.trim()).filter(Boolean);
}
function sufijoTalla(t){
  const n = Math.round(parseFloat(t.replace(',', '.')) * 10);
  return isFinite(n) ? String(n).padStart(3, '0') : t.replace(/[^A-Za-z0-9]/g, '');
}
function filasDe(it){
  const tallas = listaTallas(val(it.id, 'tallas'));
  if (!tallas.length) return [{ id: it.id, grupo: it.grupo, size: '' }];
  return tallas.map((t) => ({ id: it.id + '-' + sufijoTalla(t), grupo: it.grupo || it.id, size: t }));
}

let state = {};
try { state = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch(e){ state = {}; }

function val(id, campo){
  const s = state[id];
  if (s && Object.prototype.hasOwnProperty.call(s, campo)) return s[campo];
  return ORIG[id][campo];
}
function set(id, campo, v){
  if (!state[id]) state[id] = {};
  if (v === ORIG[id][campo]) delete state[id][campo];
  else state[id][campo] = v;
  if (!Object.keys(state[id]).length) delete state[id];
  guardar();
}
function editado(id){ return !!state[id]; }

// orden de fotos con la principal al frente
function fotosOrdenadas(it){
  const i = val(it.id, 'main') || 0;
  const idx = it.fotos.map((_, n) => n);
  idx.splice(i, 1);
  return [i].concat(idx);
}

let guardarT;
const savedTag = document.getElementById('saved');
function guardar(){
  clearTimeout(guardarT);
  guardarT = setTimeout(() => {
    try{
      localStorage.setItem(KEY, JSON.stringify(state));
      savedTag.classList.add('on');
      setTimeout(() => savedTag.classList.remove('on'), 1200);
    }catch(e){}
    contadores();
  }, 250);
}

let moneda = 'USD';
try{ moneda = localStorage.getItem(KEY + '-moneda') || 'USD'; }catch(e){}
const selMoneda = document.getElementById('moneda');
selMoneda.value = moneda;
selMoneda.addEventListener('change', () => {
  moneda = selMoneda.value;
  try{ localStorage.setItem(KEY + '-moneda', moneda); }catch(e){}
});

const list = document.getElementById('list');
const q = document.getElementById('q');
const cat = document.getElementById('cat');
const estado = document.getElementById('estado');
const count = document.getElementById('count');
const FLAG_LABEL = { dup:'Duplicado', check:'Confirmar' };

function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function autoGrow(ta){ ta.style.height='auto'; ta.style.height=(ta.scrollHeight+2)+'px'; }
function url(f){ return DATA.urlbase + f + '.jpg'; }

function card(it){
  const el = document.createElement('article');
  el.className = 'card' + (editado(it.id) ? ' edited' : '');
  const orden = fotosOrdenadas(it);
  const principal = orden[0];
  const n = it.fotos.length;

  const flag = it.nota
    ? '<div class="flag flag-' + it.nota[0] + '"><b>' + FLAG_LABEL[it.nota[0]] + '</b><span>' + esc(it.nota[1]) + '</span></div>'
    : '';
  const nFilas = filasDe(it).length;
  const chip = it.grupo
    ? '<span class="chip">grupo ' + esc(it.grupo) + ' · ' + esc(it.color) + '</span>'
    : '';
  const chipTallas = nFilas > 1
    ? '<span class="chip chip-t">' + nFilas + ' tallas · ' + nFilas + ' filas en el CSV</span>'
    : '';
  const campoTallas = ORIG[it.id].tallas
    ? '<label class="f mono f-tallas"><span>Tallas disponibles</span>' +
        '<input type="text" data-campo="tallas" placeholder="5, 5.5, 6…" value="' + esc(val(it.id,'tallas')) + '">' +
        '<em class="ayudatira">Se exporta una fila por talla, todas con el mismo item_group_id y el mismo precio.</em>' +
      '</label>'
    : '';

  const tira = n > 1
    ? '<div class="tira" role="group" aria-label="Elegir foto principal">' +
        it.fotos.map((f, i) =>
          '<button type="button" data-foto="' + i + '" aria-pressed="' + (i === principal) + '" ' +
          'title="Usar ' + esc(f) + '.jpg como foto principal">' +
          '<img src="data:image/jpeg;base64,' + it.imgs[i] + '" alt="' + esc(f) + '.jpg"></button>').join('') +
      '</div><p class="ayudatira">Toca una foto para volverla la principal del producto.</p>'
    : '';

  const urlRow = (tag, f, esP) =>
    '<div class="urlrow"><span class="tag' + (esP ? ' p' : '') + '">' + tag + '</span>' +
    '<code>' + esc(url(f)) + '</code>' +
    '<button class="btn btn-sm" type="button" data-url="' + esc(url(f)) + '"><span>Copiar</span></button></div>';

  el.innerHTML =
    '<div class="shot">' +
      '<img src="data:image/jpeg;base64,' + it.imgs[principal] + '" alt="' + esc(val(it.id,'nombre')) + '">' +
      '<div class="meta"><span class="sku">' + esc(it.id) + '</span>' +
        '<span class="fotos">' + n + (n === 1 ? ' foto' : ' fotos') + '</span></div>' +
      '<span class="editedtag">Editado</span>' +
      tira +
    '</div>' +
    '<div class="body">' +
      '<div class="linea"><span class="cat">' + esc(it.cat) + '</span>' + chip + chipTallas + '</div>' +
      '<label class="f f-nombre"><span>Nombre del producto</span>' +
        '<input type="text" data-campo="nombre" value="' + esc(val(it.id,'nombre')) + '"></label>' +
      flag +
      '<label class="f"><span>Copy para redes</span>' +
        '<textarea class="copy" data-campo="copy">' + esc(val(it.id,'copy')) + '</textarea></label>' +
      '<div class="ficha">' +
        '<label class="f mono"><span>Precio</span>' +
          '<input type="text" inputmode="decimal" data-campo="price" placeholder="49.99" value="' + esc(val(it.id,'price')) + '"></label>' +
        '<label class="f mono"><span>Link del producto</span>' +
          '<input type="url" data-campo="link" placeholder="https://…" value="' + esc(val(it.id,'link')) + '"></label>' +
        '<label class="f"><span>Disponibilidad</span><select data-campo="availability">' +
          DISPONIBILIDAD.map((o) => '<option value="' + o[0] + '"' +
            (val(it.id,'availability') === o[0] ? ' selected' : '') + '>' + o[1] + '</option>').join('') +
        '</select></label>' +
        campoTallas +
      '</div>' +
      '<details class="urls"><summary>URLs de imagen (' + n + ')</summary><div class="urlbody">' +
        orden.map((i, pos) => urlRow(pos === 0 ? 'Principal' : 'Extra ' + pos, it.fotos[i], pos === 0)).join('') +
        '<div class="urlrow"><span class="tag">Todas</span>' +
          '<button class="btn btn-sm" type="button" data-url="' +
            esc(orden.map((i) => url(it.fotos[i])).join('\n')) +
          '"><span>Copiar las ' + n + '</span></button></div>' +
      '</div></details>' +
      '<div class="actions">' +
        '<button class="btn btn-primary" type="button" data-copy="todo"><span>Copiar nombre + copy</span></button>' +
        '<button class="btn" type="button" data-copy="nombre"><span>Solo el nombre</span></button>' +
        '<button class="btn" type="button" data-copy="copy"><span>Solo el copy</span></button>' +
        '<span class="spacer"></span>' +
        '<button class="btn btn-sm" type="button" data-reset="1"><span>Restablecer</span></button>' +
      '</div>' +
    '</div>';

  const ta = el.querySelector('textarea.copy');
  requestAnimationFrame(() => autoGrow(ta));
  ta.addEventListener('input', () => {
    autoGrow(ta); set(it.id,'copy',ta.value); el.classList.toggle('edited', editado(it.id));
  });

  el.querySelectorAll('[data-campo]').forEach((f) => {
    if (f === ta) return;
    f.addEventListener(f.tagName === 'SELECT' ? 'change' : 'input', () => {
      set(it.id, f.dataset.campo, f.value);
      el.classList.toggle('edited', editado(it.id));
      if (f.dataset.campo === 'tallas'){
        const c = el.querySelector('.chip-t');
        const k = filasDe(it).length;
        if (c) c.textContent = k > 1 ? k + ' tallas · ' + k + ' filas en el CSV' : '1 fila en el CSV';
      }
    });
  });

  el.querySelectorAll('[data-foto]').forEach((b) => {
    b.addEventListener('click', () => { set(it.id, 'main', Number(b.dataset.foto)); render(); });
  });

  el.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const k = btn.dataset.copy;
      const nom = val(it.id,'nombre'), cp = val(it.id,'copy');
      copiar(k === 'nombre' ? nom : k === 'copy' ? cp : nom + '\n\n' + cp, btn);
    });
  });
  el.querySelectorAll('[data-url]').forEach((btn) => {
    btn.addEventListener('click', () => copiar(btn.dataset.url, btn));
  });
  el.querySelector('[data-reset]').addEventListener('click', () => {
    delete state[it.id]; guardar(); render();
  });
  return el;
}

function copiar(text, btn){
  const span = btn.querySelector('span') || btn;
  if (!btn.dataset.label) btn.dataset.label = span.textContent;
  const done = (ok) => {
    span.textContent = ok ? 'Copiado' : 'No se pudo copiar';
    btn.classList.toggle('ok', ok);
    btn.classList.toggle('bad', !ok);
    clearTimeout(btn._t);
    btn._t = setTimeout(() => {
      span.textContent = btn.dataset.label; btn.classList.remove('ok','bad');
    }, 1700);
  };
  try{
    if (navigator.clipboard && window.isSecureContext){
      navigator.clipboard.writeText(text).then(() => done(true), () => done(fallback(text)));
      return;
    }
  }catch(e){}
  done(fallback(text));
}

function fallback(text){
  try{
    const ta = document.createElement('textarea');
    ta.value = text; ta.setAttribute('readonly','');
    ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
    document.body.appendChild(ta); ta.select();
    const ok = document.execCommand('copy');
    document.body.removeChild(ta);
    return ok;
  }catch(e){ return false; }
}

let visibles = [];
function render(){
  const term = q.value.trim().toLowerCase();
  const c = cat.value, e = estado.value;
  visibles = DATA.items.filter((it) => {
    if (c && it.cat !== c) return false;
    if (e === 'sinprecio' && val(it.id,'price').trim()) return false;
    if (e === 'sinlink' && val(it.id,'link').trim()) return false;
    if (e === 'revisar' && !it.nota) return false;
    if (e === 'variantes' && !it.grupo) return false;
    if (e === 'editado' && !editado(it.id)) return false;
    if (!term) return true;
    return (it.id + ' ' + val(it.id,'nombre') + ' ' + val(it.id,'copy') + ' ' + it.cat + ' ' + it.color)
      .toLowerCase().includes(term);
  });
  list.textContent = '';
  if (!visibles.length){
    const p = document.createElement('p');
    p.className = 'empty';
    p.textContent = 'Ninguna fila coincide con ese filtro.';
    list.appendChild(p);
  } else {
    const frag = document.createDocumentFragment();
    visibles.forEach((it) => frag.appendChild(card(it)));
    list.appendChild(frag);
  }
  count.textContent = visibles.length + ' de ' + DATA.items.length;
  contadores();
}

function contadores(){
  document.getElementById('pendPrecio').textContent =
    DATA.items.filter((it) => !val(it.id,'price').trim()).length;
  document.getElementById('pendLink').textContent =
    DATA.items.filter((it) => !val(it.id,'link').trim()).length;
  document.getElementById('filasCsv').textContent =
    DATA.items.reduce((n, it) => n + filasDe(it).length, 0);
}

q.addEventListener('input', render);
cat.addEventListener('change', render);
estado.addEventListener('change', render);

document.getElementById('genLinks').addEventListener('click', () => {
  let base = document.getElementById('dominio').value.trim();
  if (!base) return;
  if (!/^https?:\/\//i.test(base)) base = 'https://' + base;
  if (!base.endsWith('/')) base += '/';
  DATA.items.forEach((it) => { if (!val(it.id,'link').trim()) set(it.id,'link', base + it.id); });
  render();
});

document.getElementById('genPrecio').addEventListener('click', () => {
  const p = document.getElementById('precioBulk').value.trim();
  if (!p) return;
  DATA.items.forEach((it) => { if (!val(it.id,'price').trim()) set(it.id,'price', p); });
  render();
});

const btnReset = document.getElementById('reset');
btnReset.addEventListener('click', () => {
  if (btnReset.dataset.armed !== '1'){
    btnReset.dataset.armed = '1';
    btnReset.classList.add('bad');
    btnReset.textContent = 'Confirmar: borra todo';
    clearTimeout(btnReset._t);
    btnReset._t = setTimeout(() => {
      btnReset.dataset.armed = '0'; btnReset.classList.remove('bad');
      btnReset.textContent = 'Restablecer todo';
    }, 4000);
    return;
  }
  state = {}; guardar();
  btnReset.dataset.armed = '0'; btnReset.classList.remove('bad');
  btnReset.textContent = 'Restablecer todo';
  render();
});

function campoCsv(s){
  s = s == null ? '' : String(s);
  return /[",\r\n]/.test(s) ? '"' + s.replace(/"/g,'""') + '"' : s;
}
document.getElementById('descargar').addEventListener('click', (ev) => {
  const filas = [DATA.header.slice()];
  DATA.items.forEach((it) => {
    const orden = fotosOrdenadas(it);
    const main = it.fotos[orden[0]];
    const resto = orden.slice(1).map((i) => it.fotos[i]);
    const precio = val(it.id,'price').trim();
    const nombre = val(it.id,'nombre');
    filasDe(it).forEach((f) => {
      filas.push([
        f.id, it.base, main + '.jpg', resto.map((x) => x + '.jpg').join(', '),
        url(main), resto.map(url).join(','),
        f.size ? nombre + ', talla ' + f.size : nombre,
        val(it.id,'copy'),
        precio ? precio + ' ' + moneda : '',
        val(it.id,'link').trim(),
        'Forza WorkGear', val(it.id,'availability'), 'new',
        f.grupo, it.color, f.size,
      ]);
    });
  });
  const csv = '\uFEFF' + filas.map((f) => f.map(campoCsv).join(',')).join('\r\n') + '\r\n';
  const blob = new Blob([csv], { type:'text/csv;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'catalogo_forza_workgear.csv';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  const btn = ev.currentTarget, span = btn.querySelector('span');
  span.textContent = 'Descargado'; btn.classList.add('ok');
  setTimeout(() => { span.textContent = 'Descargar CSV'; btn.classList.remove('ok'); }, 1800);
});

render();
</script>
</body>
</html>
